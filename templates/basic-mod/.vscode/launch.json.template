{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run Hytale Server",
            "request": "launch",
            "mainClass": "com.hypixel.hytale.Main",
            "args": [
                "--allow-op",
                "--disable-sentry",
                "--assets={{ASSETS_ZIP_PATH}}",
                "--mods={{COMPANION_BUILT_MODS_PATH}}"
            ],
            "cwd": "${workspaceFolder}/run"
        }
    ]
}
