{
  "Id": "Sensor.SearchRay",
  "Title": "Sensor: SearchRay",
  "Color": "#7091F0",
  "Description": "Fire a ray at a specific angle to see if what it hits matches a given sought block",
  "Inputs": [],
  "Outputs": [
    {
      "Id": "Output",
      "Type": "PositionSensor",
      "Color": "#7091F0",
      "Label": "For"
    }
  ],
  "Content": [
    {
      "Id": "Once",
      "Type": "Bool",
      "Description": "Sensor only triggers once",
      "Options": {
        "Label": "Once",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "Enabled",
      "Type": "Bool",
      "Description": "Whether this sensor should be enabled on the NPC",
      "Options": {
        "Label": "Enabled",
        "Default": true,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "Name",
      "Type": "SmallString",
      "Description": "The id of this search ray sensor so the position can be cached",
      "Options": {
        "Label": "Name",
        "Required": true,
        "DisallowEmpty": true,
        "Width": 220,
        "Computable": true
      }
    },
    {
      "Id": "Angle",
      "Type": "Float",
      "Description": "Angle to fire the ray",
      "Options": {
        "Label": "Angle",
        "Required": true,
        "Min": -90,
        "Max": 90,
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "Range",
      "Type": "Float",
      "Description": "How far to search",
      "Options": {
        "Label": "Range",
        "Required": true,
        "Min": 0,
        "Max": 96,
        "MinExclusive": true,
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "Blocks",
      "Type": "SmallString",
      "Description": "The blockset to search for",
      "Options": {
        "Label": "Blocks",
        "Required": true,
        "Width": 220,
        "Computable": true,
        "SymbolLookup": {
          "indexKind": "registeredAssets",
          "key": "BlockSet"
        }
      }
    },
    {
      "Id": "MinRetestAngle",
      "Type": "Float",
      "Description": "The minimum change in NPC rotation before rays stop being throttled",
      "Options": {
        "Label": "MinRetestAngle",
        "Min": 0,
        "Max": 360,
        "Default": 5,
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "MinRetestMove",
      "Type": "Float",
      "Description": "The minimum distance the NPC needs to move while facing the same direction before rays stop being throttled",
      "Options": {
        "Label": "MinRetestMove",
        "Min": 0,
        "MinExclusive": true,
        "Default": 1,
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "ThrottleTime",
      "Type": "Float",
      "Description": "The delay between retests when an NPC is facing the same direction",
      "Options": {
        "Label": "ThrottleTime",
        "Min": 0,
        "MinExclusive": true,
        "Default": 0.5,
        "Width": 88,
        "Computable": true
      }
    }
  ],
  "Schema": {
    "Once": "Once",
