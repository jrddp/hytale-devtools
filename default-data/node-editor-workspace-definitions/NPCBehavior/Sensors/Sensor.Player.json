{
  "Id": "Sensor.Player",
  "Title": "Sensor: Player",
  "Color": "#7091F0",
  "Description": "Test if player matching specific attributes and filters is in range",
  "Inputs": [
    {
      "Id": "PrioritiserPin",
      "Type": "ISensorEntityPrioritiser",
      "Color": "#7091F0",
      "Label": "Prioritiser",
      "Description": "A prioritiser for selecting results based on additional parameters"
    },
    {
      "Id": "FiltersPin",
      "Type": "IEntityFilter",
      "Color": "#60C8B8",
      "Label": "Filters",
      "Description": "A series of entity filter sensors to test",
      "Multiple": true
    }
  ],
  "Outputs": [
    {
      "Id": "Output",
      "Type": "PositionSensor",
      "Color": "#7091F0",
      "Label": "For"
    },
    {
      "Id": "CollectorPin",
      "Type": "ISensorEntityCollector",
      "Color": "#7091F0",
      "Label": "Collector",
      "Description": "A collector which can process all checked entities and act on them based on whether they match or not"
    }
  ],
  "Content": [
    {
      "Id": "Once",
      "Type": "Bool",
      "Description": "Sensor only triggers once",
      "Options": {
        "Label": "Once",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "Enabled",
      "Type": "Bool",
      "Description": "Whether this sensor should be enabled on the NPC",
      "Options": {
        "Label": "Enabled",
        "Default": true,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "MinRange",
      "Type": "Float",
      "Description": "Minimum range to test entities in",
      "Options": {
        "Label": "MinRange",
        "Default": 0,
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "Range",
      "Type": "Float",
      "Description": "Maximum range to test entities in",
      "Options": {
        "Label": "Range",
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "LockOnTarget",
      "Type": "Bool",
      "Description": "Matched target becomes locked target",
      "Options": {
        "Label": "LockOnTarget",
        "Default": false,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "LockedTargetSlot",
      "Type": "SmallString",
      "Description": "The target slot to use for locking on or unlocking",
      "Options": {
        "Label": "LockedTargetSlot",
        "Default": "LockedTarget",
        "Width": 220,
        "Computable": true
      }
    },
    {
      "Id": "AutoUnlockTarget",
      "Type": "Bool",
      "Description": "Unlock locked target when sensor not matching it anymore",
      "Options": {
        "Label": "AutoUnlockTarget",
        "Default": false,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "OnlyLockedTarget",
      "Type": "Bool",
      "Description": "Test only locked target",
      "Options": {
        "Label": "OnlyLockedTarget",
        "Default": false,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "IgnoredTargetSlot",
      "Type": "SmallString",
      "Description": "The target slot to use for ignoring",
      "Options": {
        "Label": "IgnoredTargetSlot",
        "Width": 220,
        "Computable": true
      }
    },
    {
      "Id": "UseProjectedDistance",
      "Type": "Bool",
      "Description": "Use the projected movement direction vector for distance, rather than the Euclidean distance",
      "Options": {
        "Label": "UseProjectedDistance",
        "Default": false,
        "Width": 18,
        "Computable": true
      }
    }
  ],
  "Schema": {
    "Once": "Once",
    "Enabled": "Enabled",
    "MinRange": "MinRange",
    "Range": "Range",
    "LockOnTarget": "LockOnTarget",
    "LockedTargetSlot": "LockedTargetSlot",
    "AutoUnlockTarget": "AutoUnlockTarget",
    "OnlyLockedTarget": "OnlyLockedTarget",
    "IgnoredTargetSlot": "IgnoredTargetSlot",
    "UseProjectedDistance": "UseProjectedDistance",
    "Prioritiser": {
      "Pin": "PrioritiserPin",
      "Node": "PrioritiserVariants"
    },
    "Collector": {
      "Pin": "CollectorPin",
      "Node": "CollectorVariants"
    },
    "Filters": {
      "Pin": "FiltersPin",
      "Node": "FilterVariants"
    },
    "Type": "Player"
  }
}
