{
  "Id": "Sensor.ValueProviderWrapper",
  "Title": "ValueProviderWrapper",
  "Color": "#7091F0",
  "Description": "Wraps a sensor and passes down some additional parameter overrides pulled from the value store",
  "Inputs": [
    {
      "Id": "SensorPin",
      "Type": "Sensor",
      "Color": "#7091F0",
      "Label": "Sensor",
      "Description": "Sensor to wrap"
    },
    {
      "Id": "ValueToParameterMappingsPin",
      "Type": "ValueToParameterMapping",
      "Color": "#7091F0",
      "Label": "ValueToParameterMappings",
      "Description": "The mappings of values to override parameters",
      "Multiple": true
    }
  ],
  "Outputs": [
    {
      "Id": "Output",
      "Type": "Sensor",
      "Color": "#7091F0",
      "Label": "Sensor"
    }
  ],
  "Content": [
    {
      "Id": "Once",
      "Type": "Bool",
      "Description": "Sensor only triggers once",
      "Options": {
        "Label": "Once",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "Enabled",
      "Type": "Bool",
      "Description": "Whether this sensor should be enabled on the NPC",
      "Options": {
        "Label": "Enabled",
        "Default": true,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "PassValues",
      "Type": "Bool",
      "Description": "Used to enable/disable passing of values in components",
      "Options": {
        "Label": "PassValues",
        "Default": true,
        "Width": 18,
        "Computable": true
      }
    }
  ],
  "Schema": {
    "Once": "Once",
    "Enabled": "Enabled",
    "PassValues": "PassValues",
    "Sensor": {
      "Pin": "SensorPin",
      "Node": "SensorVariants",
      "AllowComponentReferences": true
    },
    "ValueToParameterMappings": {
      "Pin": "ValueToParameterMappingsPin",
      "Node": "ValueToParameterMapping.ValueToParameterMapping"
    },
    "Type": "ValueProviderWrapper"
  }
}
