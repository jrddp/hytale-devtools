{
  "Id": "Structural.RandomInstructionNode",
  "Title": "Random Instruction",
  "Color": "#2D3746",
  "Description": "Randomised list of weighted instructions.",
  "Inputs": [
    {
      "Id": "SensorPin",
      "Type": "Sensor",
      "Color": "#7091F0",
      "Label": "Sensor",
      "Description": "Sensor for testing if instruction can be applied"
    },
    {
      "Id": "Input",
      "Type": "Instruction",
      "Color": "#2D3746",
      "Label": "Parent"
    }
  ],
  "Outputs": [
    {
      "Id": "WeightedInstructionsPin",
      "Type": "WeightedInstruction",
      "Color": "#2D3746",
      "Label": "Instructions",
      "Description": "List of weighted instructions to select from",
      "Multiple": true
    }
  ],
  "Content": [
    {
      "Id": "Name",
      "Type": "SmallString",
      "Description": "Optional name for descriptor",
      "Options": {
        "Label": "Name",
        "Width": 220
      }
    },
    {
      "Id": "Tag",
      "Type": "SmallString",
      "Description": "Internal identifier tag for debugging",
      "Options": {
        "Label": "Tag",
        "Width": 220
      }
    },
    {
      "Id": "Enabled",
      "Type": "Bool",
      "Description": "Whether this instruction should be enabled on the NPC",
      "Options": {
        "Label": "Enabled",
        "Default": true,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "Continue",
      "Type": "Bool",
      "Description": "Continue after this instruction was executed",
      "Options": {
        "Label": "Continue",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "TreeMode",
      "Type": "Bool",
      "Description": "Whether this instruction and its contents should be treated like a traditional behaviour tree.",
      "Options": {
        "Label": "TreeMode",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "InvertTreeModeResult",
      "Type": "Bool",
      "Description": "Whether or not to invert the result of TreeMode evaluation when passing up to parent TreeMode instructions",
      "Options": {
        "Label": "InvertTreeModeResult",
        "Default": false,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "ResetOnStateChange",
      "Type": "Bool",
      "Description": "Whether to reset when NPC state changes",
      "Options": {
        "Label": "ResetOnStateChange",
        "Default": true,
        "Width": 18,
        "Computable": true
      }
    },
    {
      "Id": "ExecuteFor",
      "Type": "Tuple",
      "Description": "How long to execute the chosen instruction before picking another",
      "Options": {
        "Label": "ExecuteFor",
        "Default": [
          1.7976931348623157e+308,
          1.7976931348623157e+308
        ],
        "Width": 240,
        "TupleSize": 2,
        "TupleItemType": "Float",
        "Computable": true
      }
    }
  ],
  "Schema": {
    "Type": "Random",
    "Name": "Name",
    "Tag": "Tag",
    "Enabled": "Enabled",
    "Sensor": {
      "Pin": "SensorPin",
      "Node": "SensorVariants",
      "AllowComponentReferences": true
    },
    "Instructions": {
      "Pin": "WeightedInstructionsPin",
      "Node": "Structural.WeightedInstruction"
    },
    "Continue": "Continue",
    "TreeMode": "TreeMode",
    "InvertTreeModeResult": "InvertTreeModeResult",
    "ResetOnStateChange": "ResetOnStateChange",
    "ExecuteFor": "ExecuteFor"
  }
}
