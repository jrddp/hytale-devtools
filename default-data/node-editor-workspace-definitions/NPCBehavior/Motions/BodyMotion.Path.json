  "Schema": {
    "StartAtNearestNode": "StartAtNearestNode",
    "PathWidth": "PathWidth",
    "NodeWidth": "NodeWidth",
    "MinRelSpeed": "MinRelSpeed",
    "MaxRelSpeed": "MaxRelSpeed",
    "MinWalkDistance": "MinWalkDistance",
    "MaxWalkDistance": "MaxWalkDistance",
    "Direction": "Direction",
    "Shape": "Shape",
    "MinNodeDelay": "MinNodeDelay",
    "MaxNodeDelay": "MaxNodeDelay",
    "UseNodeViewDirection": "UseNodeViewDirection",
    "NodePauseScaleRange": "NodePauseScaleRange",
    "NodePauseExtraPercentRange": "NodePauseExtraPercentRange",
    "PickRandomAngle": "PickRandomAngle",
    "ViewSegments": "ViewSegments",
    "Type": "Path"
  }
