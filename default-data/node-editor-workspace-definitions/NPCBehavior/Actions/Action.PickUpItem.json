{
  "Id": "Action.PickUpItem",
  "Title": "Action: PickUpItem",
  "Color": "#CC3361",
  "Description": "Pick up an item",
  "Inputs": [
    {
      "Id": "Input",
      "Type": "ActionListItem",
      "Color": "#CC3361",
      "Label": "Actions"
    }
  ],
  "Content": [
    {
      "Id": "Once",
      "Type": "Bool",
      "Description": "Execute only once",
      "Options": {
        "Label": "Once",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "Delay",
      "Type": "List",
      "Description": "Range of time to delay in seconds",
      "Options": {
        "Label": "Delay",
        "Default": [
          1,
          1
        ],
        "Width": 240,
        "Computable": true
      }
    },
    {
      "Id": "Range",
      "Type": "Float",
      "Description": "The range the item will be picked up from",
      "Options": {
        "Label": "Range",
        "Default": 1,
        "Width": 88,
        "Computable": true
      }
    },
    {
      "Id": "StorageTarget",
