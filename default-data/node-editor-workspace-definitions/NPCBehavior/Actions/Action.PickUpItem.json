      "Options": {
        "Label": "Hoover",
        "Default": false,
        "Width": 18
      }
    },
    {
      "Id": "Items",
      "Type": "List",
      "Description": "A list of glob item patterns to match",
      "Options": {
        "Label": "Items",
        "Width": 240,
        "Computable": true,
        "SymbolLookup": {
          "indexKind": "registeredAssets",
          "key": "Item"
        }
      }
    }
  ],
  "Schema": {
    "Once": "Once",
    "Delay": "Delay",
    "Range": "Range",
    "StorageTarget": "StorageTarget",
    "Hoover": "Hoover",
    "Items": "Items",
    "Type": "PickUpItem"
