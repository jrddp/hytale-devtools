        "Label": "StorageTarget",
        "Default": "Hotbar",
        "Width": 220,
        "Values": [
          "Hotbar",
          "Inventory",
          "Destroy"
        ],
        "Computable": true
      }
    },
    {
      "Id": "Hoover",
      "Type": "Bool",
